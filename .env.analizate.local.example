# Copy to .env only for an Analizate deployment. Do not commit the real .env.
APP_ENV=production
POSTGRES_DB=muffin_analizate
POSTGRES_USER=muffin
POSTGRES_PASSWORD=replace-with-a-long-unique-password
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30

DEFAULT_INSTITUTION_NAME=LABORATORIO DE ANALISIS CLINICO ANALIZATE
DEFAULT_INSTITUTION_SLUG=analizate-huaraz
MUFFIN_INSTITUTION_NAME=Analizate Huaraz
MUFFIN_INSTITUTION_SLUG=analizate-huaraz
MUFFIN_CLIENT_ROOT=CLIENTES/ANALIZATE - HUARAZ
MUFFIN_BRAND_IMAGE=CLIENTES/ANALIZATE - HUARAZ/logo_remaster.jpeg
MUFFIN_PRODUCT_IMAGE=MUFFIN_ICONO.jpg
MUFFIN_MASCOT_IMAGE=MUFFIN_SINFONDO.png
MUFFIN_SIGNERS_CONFIG=CLIENTES/ANALIZATE - HUARAZ/signers.json
MUFFIN_PRODUCT_NAME=MUFFIN Laboratorio de Analisis Clinico
MUFFIN_PRODUCT_TAGLINE=Laboratorio de analisis clinico Analizate
MUFFIN_COPYRIGHT_OWNER=Analizate Huaraz
MUFFIN_IP_OWNER=RyM SAC
MUFFIN_VERSION=1.0

# 1 = print final validator stamp/signature; 0 = suppress it from the report.
MUFFIN_REPORT_STAMP=0

BOOTSTRAP_ADMIN_USERNAME=admin-analizate
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-character-minimum-password
BOOTSTRAP_ADMIN_GIVEN_NAME=Administrador
BOOTSTRAP_ADMIN_FAMILY_NAME=Analizate
ANALIZATE_ADMIN_PASSWORD=replace-with-a-unique-12-character-minimum-password
ANALIZATE_LAB_PASSWORD=replace-with-a-unique-12-character-minimum-password

MUFFIN_API_PORT=8000
MUFFIN_FRONTEND_PORT=8501
MUFFIN_BIND_ADDRESS=0.0.0.0
