# Copy to .env on the NAS. Do not commit the real file.
POSTGRES_DB=muffin
POSTGRES_USER=muffin
POSTGRES_PASSWORD=replace-with-a-long-unique-password
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
DEFAULT_INSTITUTION_NAME=MUFFIN Microbiología Hospitalaria
DEFAULT_INSTITUTION_SLUG=muffin-padre
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-character-minimum-password
BOOTSTRAP_ADMIN_GIVEN_NAME=Administrador
BOOTSTRAP_ADMIN_FAMILY_NAME=MUFFIN
MUFFIN_API_PORT=8000
MUFFIN_FRONTEND_PORT=8501
MUFFIN_BIND_ADDRESS=0.0.0.0
# Client branding sockets. Leave empty for MUFFIN padre or set per institution.
MUFFIN_INSTITUTION_NAME=
MUFFIN_INSTITUTION_SLUG=
MUFFIN_CLIENT_ROOT=
MUFFIN_BRAND_IMAGE=
MUFFIN_PRODUCT_IMAGE=
MUFFIN_MASCOT_IMAGE=
MUFFIN_SIGNERS_CONFIG=
MUFFIN_PRODUCT_NAME=MUFFIN Microbiología Hospitalaria
MUFFIN_PRODUCT_TAGLINE=Microbiología: Unidad de Fuentes, Flujos e Informes Nosocomiales
MUFFIN_COPYRIGHT_OWNER=
MUFFIN_IP_OWNER=RyM SAC
MUFFIN_VERSION=1.0
# Optional fallback when the NAS cannot pull from Docker Hub and already has a Python image.
# MUFFIN_PYTHON_BASE_IMAGE=microbiolog-ia:latest
