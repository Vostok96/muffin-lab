ARG PYTHON_BASE_IMAGE=python:3.12-slim
FROM ${PYTHON_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SIMCORE_CLONE_HOST=0.0.0.0 \
    SIMCORE_CLONE_PORT=8501

WORKDIR /app

COPY server.py ./
COPY docs/ ./docs/
COPY mirror/ ./mirror/
COPY CLIENTES/ ./CLIENTES/
COPY MUFFIN_FAVICON.png MUFFIN_ICONO.jpg MUFFIN_SINFONDO.png ./

EXPOSE 8501

CMD ["python", "server.py"]
